{
  "manifest_version": 3,
  "name": "ChatGPT Web Agent",
  "version": "0.7.0",
  "description": "Use your existing ChatGPT web session as an autonomous agent that can inspect and operate your real Chrome browser from a side panel.",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "debugger", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "options_page": "options.html",
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open ChatGPT Web Agent" }
}
