# Public OAuth gateway used by your Custom GPT.
PORT=8787
PUBLIC_BASE_URL=https://agent.example.com
INTERNAL_PORT=8790
SPAWN_BACKEND=true

# OAuth credentials for the Custom GPT Action configuration.
# These are credentials for YOUR Web Agent, not OpenAI API credentials.
OAUTH_CLIENT_ID=chatgpt-web-agent
OAUTH_CLIENT_SECRET=replace-with-a-long-random-client-secret
OAUTH_SIGNING_SECRET=replace-with-a-long-random-signing-secret
OAUTH_LOGIN_PASSWORD=replace-with-your-web-agent-login-password
# Paste the exact OAuth callback URL shown by the GPT Action builder.
# Multiple exact URLs can be comma-separated.
OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/replace-with-gpt-oauth-callback
OAUTH_DEFAULT_SCOPE=agent:control
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# Optional. If omitted, the OAuth gateway creates an ephemeral internal key
# and passes it only to the private backend process.
INTERNAL_API_KEY=

# Chrome agent connection. This is internal to your Web Agent and has no
# relationship to OpenAI API billing.
AGENT_ID=desktop-chrome
AGENT_TOKEN=replace-with-a-long-random-agent-token

# WordPress bridge connection.
WORDPRESS_BASE_URL=https://example.com
WORDPRESS_TOKEN=replace-with-token-from-wordpress-plugin

REQUEST_TIMEOUT_MS=20000
DATA_DIR=./data
# Optional comma-separated HTTPS hosts allowed for visual reference images.
REFERENCE_ALLOWED_HOSTS=
